{
  "name": "dlmm-agent",
  "version": "2.0.0",
  "type": "module",
  "description": "Autonomous DLMM LP agent for Meteora on Solana (TypeScript)",
  "main": "dist/entrypoints/daemon.js",
  "scripts": {
    "start": "node dist/entrypoints/daemon.js",
    "dev": "DRY_RUN=true tsx watch src/entrypoints/daemon.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "parallel-run": "./scripts/parallel-run/run-parallel.sh"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1",
    "jsonrepair": "^3.13.3",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.23.0",
    "typescript": "5.6",
    "vitest": "^2.1.9",
    "zod": "3.23",
    "zod-to-json-schema": "3.23"
  }
}
