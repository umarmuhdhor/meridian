# Meridian — .env template (production keys go in ~/meridian/.env, chmod 600, gitignored).
# See deploy/OPERATIONS.md §5 for the full canonical list.

# ── LIVE trading (Meteora + Solana) ──────────────────────────────────────────
# WALLET_PRIVATE_KEY: base58 (~87-88 chars) OR JSON byte-array. NOT base64.
WALLET_PRIVATE_KEY=your_base58_private_key_here
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM (OpenRouter or OpenAI-compatible) ────────────────────────────────────
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1   # optional override

# ── Sage delegation (Path 2 — intra-host on vivobook) ────────────────────────
# On vivobook, hermes gateway binds 127.0.0.1:8642; sage-api-proxy socat forwards
# from :8643. Meridian container reaches it via host-gateway (see docker-compose.yml
# `extra_hosts: host.docker.internal:host-gateway`).
MERIDIAN_DECIDER=sage
SAGE_BASE_URL=http://host.docker.internal:8643
SAGE_API_KEY=your_sage_api_key
SAGE_SESSION_KEY=meridian-trading
SAGE_TIMEOUT_MS=90000
# CF Access headers are NOT needed on the intra-host path. Leave commented.
# SAGE_CF_ACCESS_CLIENT_ID=
# SAGE_CF_ACCESS_CLIENT_SECRET=

# ── Dashboard (calisto.nafidinara.com) ───────────────────────────────────────
# DASHBOARD_TOKEN / BRIDGE_TOKEN: same value (daemon↔web bridge auth).
DASHBOARD_TOKEN=your_shared_bridge_token
BRIDGE_TOKEN=your_shared_bridge_token
# Regenerate per-host — do NOT copy across machines.
#   MERIDIAN_SESSION_SECRET: `openssl rand -hex 32`
#   MERIDIAN_DASHBOARD_PIN_HASH: see OPERATIONS.md §7
MERIDIAN_SESSION_SECRET=
MERIDIAN_DASHBOARD_PIN_HASH=

# ── Telegram (Calisto notify-only; Sage is the conversational brain) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
MERIDIAN_TELEGRAM_INBOUND=false

# ── Live gates ───────────────────────────────────────────────────────────────
# MERIDIAN_CHAIN=meteora + MERIDIAN_WRITE_UNSAFE=true = LIVE trading.
# In compose the CHAIN=meteora is set in docker-compose.yml env, not here.
MERIDIAN_WRITE_UNSAFE=false
DRY_RUN=false
LOG_LEVEL=info

# ── Legacy / unused (leave blank) ────────────────────────────────────────────
HELIUS_API_KEY=
LPAGENT_API_KEY=
ALLOW_SELF_UPDATE=false
